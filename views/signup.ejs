<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="max-w-md mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Sign Up</h1>

    <form action="/signup" method="POST" class="flex flex-col gap-4">
        <div>
            <label for="email">Email</label>
            <input
                id="email"
                name="email"
                type="email"
                required
                class="border border-gray-300 rounded p-2 w-full">
        </div>

        <div>
            <label for="password">Password</label>
            <input
                id="password"
                name="password"
                type="password"
                required
                class="border border-gray-300 rounded p-2 w-full">
        </div>

        <button 
            type="submit"
            class="bg-teal-700 text-white rounded px-4 py-2"
        >
        Sign Up</button>
    </form>
</body>

</html>