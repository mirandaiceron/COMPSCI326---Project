<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Campus Resources</title>
    <link rel="stylesheet" href="/style.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>

  <body class ="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    <h1 class="text-3xl font-bold border-b-2 border-gray-300 pb-2 mb-6">Campus Resources</h1>
    <% if (error) { %>
    <p class="mb-4 rounded border border-red-300 bg-red-100 p-3 text-red-700"><%= error %></p>
  <% } %>

  <h2 class="mb-4 text-2xl font-semibold">Available Resources</h2>

   <p id="status-announcer" class="sr-only" aria-live="polite"></p>

  <ul id="resources-list" tabindex="-1">
    <% resources.forEach((resource) => { %>
    <%- include("partials/resourceItem", {resource}) %>
    <% }); %>
  </ul>

  <h2 class="mb-4 text-2xl font-semibold">Add a Resource</h2>
  <form
    action="/resources"
    method="POST"
    hx-post="/resources"
    hx-target="#resources-list"
    hx-swap="beforeend"
    hx-on::after-request="if (event.detail.successful) this.reset()"
    class="flex flex-col gap-2 mb-6 md:grid md:grid-cols-2"
  >
    <div>
      <label for="name">Resource name:</label>
      <input id="name" name="name" type="text" required class="border border-gray-300 rounded p-2"/>
    </div>

    <div>
      <label for="category">Category:</label>
      <input id="category" name="category" type="text" required class="border border-gray-300 rounded p-2"/>
    </div>

    <div>
      <label for="location">Location:</label>
      <input id="location" name="location" type="text" required class="border border-gray-300 rounded p-2"/>
    </div>

    <div class="md:col-span-2">
      <label for="description">Description:</label>
      <textarea
      id="description"
      name="description"
      required
      class="border border-gray-300 rounded p-2"
      ></textarea>
    </div>

    <button type="submit" class="bg-teal-700 text-white rounded px-4 py-2 md:col-span-2">Add Resource</button>
  </form>

  <script src="/app.js"></script>

  </body>
</html>
