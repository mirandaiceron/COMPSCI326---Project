<li class="rounded border border-gray-300 p-4">
  <h3 class="text-xl font-semibold"><%= resource.name %></h3>

  <p class="mt-2"><strong>Category:</strong> <%= resource.category %></p>

  <p><strong>Location:</strong> <%= resource.location %></p>

  <p class="mt-2 text-gray-700"><%= resource.description %></p>
  <button
    type="button"
    hx-delete="/resources/<%= resource._id %>"
    hx-target="closest li"
    hx-swap="delete"
    class="mt-4 rounded bg-red-700 px-4 py-2 text-white"
  >
    Delete
  </button>
</li>
